<div class="offcanvas offcanvas-end" tabindex="-1" id="cartOffcanvas" style="width: 800px">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title">
            <i class="bi bi-cart3 me-2"></i> Mon panier
        </h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body d-flex flex-column">
        {% if cart_handler.cart.items is empty %}
            <p class="text-center text-muted mt-4">Votre panier est vide.</p>
        {% else %}
            <ul class="list-group list-group-flush flex-grow-1">
                {% for item in cart_handler.cart.items %}
                    <li class="list-group-item d-flex justify-content-between align-items-center" id="cart-item-{{ item.product.id }}">
                        <span style="flex: 1">{{ item.product.title }} ({{ item.product.price }} €)</span>
                        <div class="d-flex align-items-center gap-2" style="min-width: 180px; justify-content: flex-end">
                            <button class="btn btn-primary btn-sm rounded-circle btn-decrease" 
                                    data-url="{{ path('app_cart_decrease', {'id': item.product.id}) }}"
                                    data-id="{{ item.product.id }}">-</button>
                            <span class="badge bg-primary" id="quantity-{{ item.product.id }}">{{ item.quantity }}</span>
                            <button class="btn btn-primary btn-sm rounded-circle btn-increase" 
                                    data-url="{{ path('app_cart_add', {'id': item.product.id}) }}"
                                    data-id="{{ item.product.id }}">+</button>
                            <span style="min-width: 60px; text-align: right">{{ item.subtotal }} €</span>
                        </div>
                    </li>
                {% endfor %}
            </ul>

            <div class="mt-3">
                <div class="d-flex justify-content-between fw-bold mb-2">
                    <span>TOTAL</span>
                    <span id="cart-total">{{ cart_handler.cart.total }} €</span>
                </div>
                <div class="d-flex justify-content-between">
                    <button class="btn btn-danger btn-sm btn-clear"
                            data-url="{{ path('app_cart_clear') }}">
                        <i class="bi bi-trash"></i> Vider le panier
                    </button>
                    <a href="{{ path('app_order_checkout') }}" class="btn btn-primary">Payer</a>
                </div>
            </div>
        {% endif %}
    </div>
</div>