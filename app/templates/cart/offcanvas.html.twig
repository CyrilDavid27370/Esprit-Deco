<div class="offcanvas offcanvas-end" tabindex='-1' id="cartOffcanvas">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title">
            <i class="bi bi_cart3 me-2"></i>
            Mon panier
        </h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body d-flex flex-column">
        {% set cart = app.session.get('cart') %}

        {% if cart is empty %}
            <p class="text-center text-muted mt-4">Votre panier est vide.</p>
        {% else %}
            <ul class="list-group list-group-flush flex-grow-1">
                {% for productId, quantity in cart %}
                    <li class="list-group-item d-flex justify-content-beetween align-items-center">
                        <span>Produit #{{ productId }}</span>
                        <span class="badge bg-primary">{{ quantity }}</span>
                    </li>
                {% endfor %}
            </ul>

            <div class="mt-3 text-end">
                <a href="#" class="btn btn-danger btn-sm">
                    <i class="bi bi-trash"></i> Vider le panier
                </a>
                <a href="#" class="btn btn-primary mt-2 w-100">
                    Payer
                </a>
            </div>
        {% endif %}
    </div>
</div>
