{% extends "base.html.twig" %}

{% block title %}{{ product.title }} - EspritDéco{% endblock %}

{% block body %}
    <div class="product-show">
        {# === Cadre titre + catégorie === #}
        div class="product-header">
            <h1 class="product-title">{{ product.title }}</h1>
            <hr class="product-separator">
            <p class="product-category">{{ product.category.name}}</p>
        </div>

        {# === Carrousel d'images === #}
        {% if product.images is not empty %}
            <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    {% for image in product.images %}
                        <div class="carousel-item {% if loop.first%}active{% endif %}">
                            <img src="{{ asset(image.path) }}" class="d-block mx-auto product-carousel-img" alt="{{ image.alt}}">
                        </div>
                    {% endfor %}
                </div>

        {# Boutons de navigation seulement s'il y a + d'1 image #}
        {% if product.images|length> 1 %}
            <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Précedent</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Suivant</span>
            </button>
        {% endif %}
            </div>
        {% else %}
            <div class="no-image">🚫</div>
        {% endif %}

        {# === Description complète === #}
        <p class="product-description">{{ product.description }}</p>

        {# === Cadre prix + bouton "Ajouter au panier" === #}
        <div class="product-actions">
            <span class="badge price-badge">{{ product.price}} €</span>
            <button class="btn btn-cart">Ajouter au panier</button>
        </div>
    </div>
{% endblock %}
