{% extends 'base.html.twig' %}

{% block title %}Boutique - EspritDéco{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('product') }}
{% endblock %}

{% block body %}
    {# === Filtres === #}
    <div class="mb-4">

        {# Filtre par catégorie — préserve prix et recherche dans l'URL #}
        <div class="d-flex flex-wrap gap-2 justify-content-center mb-3">
            <a href="{{ path('app_home', {minPrice: minPrice, maxPrice: maxPrice, search: search}) }}"
               class="btn {{ selectedCategory is null ? 'btn-primary' : 'btn-outline-secondary' }}">
                Tous
            </a>
            {% for category in categories %}
                <a href="{{ path('app_home', {category: category.id, minPrice: minPrice, maxPrice: maxPrice, search: search}) }}"
                   class="btn"
                   style="{% if selectedCategory == category.id %}background-color: {{ category.color }}; color: #fff; border-color: {{ category.color }};{% else %}border: 2px solid {{ category.color }}; color: {{ category.color }};{% endif %}">
                    {{ category.name }}
                </a>
            {% endfor %}
        </div>

        {# Filtre par prix — préserve catégorie et recherche #}
        <form method="get" action="{{ path('app_home') }}"
              class="d-flex flex-wrap gap-2 justify-content-center align-items-center">
            {% if selectedCategory %}
                <input type="hidden" name="category" value="{{ selectedCategory }}">
            {% endif %}
            {% if search %}
                <input type="hidden" name="search" value="{{ search }}">
            {% endif %}
            <input type="number" name="minPrice" value="{{ minPrice ?? '' }}"
                   placeholder="Prix min (€)" min="0" step="0.01"
                   class="form-control form-control-sm" style="width: 140px;">
            <span class="text-muted">—</span>
            <input type="number" name="maxPrice" value="{{ maxPrice ?? '' }}"
                   placeholder="Prix max (€)" min="0" step="0.01"
                   class="form-control form-control-sm" style="width: 140px;">
            <button type="submit" class="btn btn-sm btn-outline-info">Appliquer</button>
            {% if minPrice is not null or maxPrice is not null %}
                <a href="{{ path('app_home', {category: selectedCategory, search: search}) }}"
                   class="btn btn-sm btn-outline-danger">Réinitialiser</a>
            {% endif %}
        </form>

    </div>

    <div class="row g-4">
        {% for product in products %}
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100">
                    {# === Titre du produit === #}
                    <div class="card-header text-center">
                        <h2 class="card-title mb-0">
                            <a href="{{ path('app_product_show', {id: product.id}) }}" class="product-link">
                                {{ product.title }}
                            </a>
                        </h2>
                    </div>

                    {# === Image principale === #}
                    {% if product.images is not empty %}
                        {% set principalImage = product.images.first %}
                        <img src="{{ asset(principalImage.path) }}" alt="{{ principalImage.alt }}" class="card-img-top">
                    {% else %}
                        <div class="no-image">🚫</div>
                    {% endif %}

                    {# === Description tronquée à 20 mots === #}
                    <div class="card-body">
                        <p class="card-text">
                            {{ product.description|split(' ')|slice(0, 20)|join(' ') }}...
                        </p>
                    </div>

                    {# === Footer : catégorie + prix === #}
                    <div class="card-footer">
                        <div class="card-meta">
                            <span class="badge" style="background-color: {{ product.category.color }}">
                                {{ product.category.name }}
                            </span>
                            <span class="badge price-badge">
                                {{ product.price }} €
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <p class="text-center text-muted py-5">Aucun produit ne correspond à votre recherche.</p>
            </div>
        {% endfor %}
    </div>

    <div class="d-flex justify-content-center mt-5">
        {{ knp_pagination_render(products) }}
    </div>
{% endblock %}
