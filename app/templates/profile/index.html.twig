{% extends 'base.html.twig' %}

{% block title %}Mon profil - EspritDéco{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <h2 class="text-center mb-1">Mon profil</h2>
            <p class="text-center text-muted mb-4">
                <i class="bi bi-person-circle"></i> {{ app.user.email }}
            </p>

            <h4 class="mb-3">Mes commandes</h4>

            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Statut</th>
                            <th>Montant</th>
                            <th>Détail</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set badge = {
                            'pending_payment': 'warning',
                            'paid':            'info',
                            'shipped':         'primary',
                            'delivered':       'success',
                            'cancelled':       'danger'
                        } %}
                        {% set label = {
                            'pending_payment': 'En attente de paiement',
                            'paid':            'Payé',
                            'shipped':         'Expédié',
                            'delivered':       'Livré',
                            'cancelled':       'Annulé'
                        } %}
                        {% for order in orders %}
                            <tr>
                                <td>{{ order.id }}</td>
                                <td>{{ order.createdAt|date('d/m/Y') }}</td>
                                <td>
                                    <span class="badge bg-{{ badge[order.status] ?? 'secondary' }}">
                                        {{ label[order.status] ?? order.status }}
                                    </span>
                                </td>
                                <td>{{ order.totalAmount|number_format(2, ',', ' ') }} €</td>
                                <td>
                                    <a href="{{ path('app_profile_order', {id: order.id}) }}" class="btn btn-sm btn-primary">
                                        Voir le détail
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Vous n'avez encore passé aucune commande.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        </div>
    </div>
{% endblock %}
