{% extends 'base.html.twig' %}

{% block title %}Gestion des produits - EspritDéco{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('admin') }}
{% endblock %}

{% block body %}
    <h2 class="text-center mb-4">Gestion des produits</h2>

    {# Bouton ajouter #}
    <div class="text-center mb-3">
        <a href="{{ path('app_admin_product_save') }}" class="btn btn-success">
            <i class="bi bi-plus-lg"></i>
        </a>
    </div>

    {# Tableau des produits #}
    <div class="table-responsive">
        <table class="table table-admin">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Prix</th>
                    <th>Catégorie</th>
                    <th>Modifier</th>
                    <th>Supprimer</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                    <tr>
                        <td>
                            <a href="{{ path('app_product_show', {id: product.id}) }}">
                                {{ product.title }}
                            </a>
                        </td>
                        <td>{{ product.price }} €</td>
                        <td>{{ product.category.name }}</td>
                        <td>
                            <a href="{{ path('app_admin_product_save', {id: product.id}) }}" class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ product.id }}">
                                <i class="bi bi-x-lg"></i>
                            </button>

                        {# Modale de confirmation #}
                        <div class="modal fade" id="deleteModal{{ product.id }}" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h2 class="modal-title">Suppression</h2>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        Etes-vous sur de vouloir supprimer <strong>{{ product.title }}</strong> ?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                        <form action="{{ path('app_admin_product_delete', {id: product.id}) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-product-' ~ product.id) }}">
                                        <button type="submit" class="btn btn-danger">Supprimer</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Bouton retour #}
    <div class="text-center mt-3">
        <a href="{{ path('app_admin') }}" class="btn btn-primary">Retour</a>
    </div>
{% endblock %}
