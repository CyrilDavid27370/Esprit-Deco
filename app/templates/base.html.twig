        <main class="flex-grow-1 py-4"">
            <div class="container">
                <p class="text-center">BLOC MAIN</p>
            </div>
        </main>

        {% include '_shared/_footer.html.twig' %}

        </body>
        {% block body %}{% endblock %}
    </body>
</html>
