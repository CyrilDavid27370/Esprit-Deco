<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
        {# Logo cliquable - retour boutique #}
        <a href="{{ path('app_home') }}" class="navbar-brand d-flex align-items-center">
            <img src="{{ asset('image/layout/logo.png') }}" alt="Esprit déco" height="30" class="me-2">
        </a>

        {# Bouton hamburger pour mobile #}
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent" aria-controls="navContent" aria-expanded="false" aria-label="Toggle navigation">
            <i class="bi bi-list fs-2"></i>
        </button>

        {# Contenu rétractable #}
        <div class="collapse navbar-collapse" id="navContent">
            {# Menu principal à gauche #}
            <ul class="navbar-nav me-auto align-items-center">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_home') }}">Boutique</a>
                </li>

            {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_admin') }}">
                        <i class="bi bi-speedometer2"></i> Espace admin
                    </a>
                </li>
            {% endif %}

                {% if app.user %}
                    {# === Utilisateur connecté : email + bouton déconnexion alignés === #}
                    <li class="nav-item d-flex align-items-center gap-2">
                        <span class="nav-link">
                            <i class="bi bi-person-circle"></i> {{ app.user.email }}
                        </span>
                        <a class="btn btn-primary btn-sm" href="{{ path('app_logout') }}">
                            <i class="bi bi-box-arrow-right"></i> Déconnexion
                        </a>
                    </li>
                {% else %}
                    {# === Utilisateur non connecté : dropdown Connexion / Enregistrement === #}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Connexion
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('app_login') }}">Connexion</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_register') }}">Enregistrement</a></li>
                        </ul>
                    </li>
                {% endif %}
            </ul>

    <div class="d-flex align-items-center gap-2">
    {# Barre de recherche #}
        <form class="d-flex" role="search" method="get" action="{{ path('app_home') }}">
            {% if app.request.query.get('category') %}
                <input type="hidden" name="category" value="{{ app.request.query.get('category') }}">
            {% endif %}
            {% if app.request.query.get('minPrice') %}
                <input type="hidden" name="minPrice" value="{{ app.request.query.get('minPrice') }}">
            {% endif %}
            {% if app.request.query.get('maxPrice') %}
                <input type="hidden" name="maxPrice" value="{{ app.request.query.get('maxPrice') }}">
            {% endif %}
            <input class="form-control me-2" type="search" name="search"
                   value="{{ app.request.query.get('search') ?? '' }}"
                   placeholder="Recherche" aria-label="Recherche">
            <button class="btn btn-search" type="submit">
                <i class="bi bi-search"></i>
            </button>
        </form>

    {# Icône panier #}
        <button class="btn btn-link" style="display: flex; flex-direction: row; align-items: center; gap: 8px;"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#cartOffcanvas">
            <i class="bi bi-cart3 fs-4 text-secondary"></i>
        {% set cartCount = cart_handler.totalQuantity %}
        {% if cartCount > 0 %}
            <span class="badge bg-danger" id="cart-count">{{ cartCount }}</span>
        {% endif %}
        </button>
    </div>
    </div>
</nav>
