{% extends 'base.html.twig' %}

{% block title %}Commande confirmée - EspritDéco{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 text-center py-5">
            <div class="mb-4 text-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                    <path d="m10.97 4.97-.02.022-3.473 4.425-2.093-2.094a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05"/>
                </svg>
            </div>
            <h2 class="mb-3">Commande confirmée !</h2>
            <p class="text-muted mb-2">Merci pour votre achat. Votre commande n°{{ order.id }} a bien été enregistrée.</p>
            <p class="text-muted mb-4">Total payé : <strong>{{ order.totalAmount }} €</strong></p>
            <a href="{{ path('app_home') }}" class="btn btn-primary">Retour à la boutique</a>
        </div>
    </div>
{% endblock %}
